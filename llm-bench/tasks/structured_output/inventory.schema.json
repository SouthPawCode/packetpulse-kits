{
  "type": "object",
  "additionalProperties": false,
  "required": ["devices"],
  "properties": {
    "devices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostname", "ip", "vlan", "role", "poe_watts"],
        "properties": {
          "hostname": {"type": "string"},
          "ip": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"},
          "vlan": {"type": "integer"},
          "role": {"enum": ["switch", "ap", "server", "camera", "gateway"]},
          "poe_watts": {"type": ["number", "null"]}
        }
      }
    }
  }
}
