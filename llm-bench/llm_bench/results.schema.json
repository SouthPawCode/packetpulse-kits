{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packetpulse.dev/schemas/llm-bench-results-1.json",
  "title": "llm-bench results.json, schema_version 1",
  "type": "object",
  "required": ["schema_version", "title", "hardware", "started_at", "finished_at", "kit_version", "battery_version", "models", "tasks", "runs", "summary", "verdicts"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string"},
    "hardware": {"type": "string"},
    "started_at": {"type": "string"},
    "finished_at": {"type": ["string", "null"]},
    "kit_version": {"type": "string"},
    "battery_version": {"type": "string"},
    "baseline": {"type": ["string", "null"]},
    "thumbnail_text": {"type": ["string", "null"]},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "label", "backend", "size_gb", "vram_after_load_mb", "gpu_share_pct", "load_seconds", "quant"],
        "properties": {
          "name": {"type": "string"},
          "label": {"type": "string"},
          "backend": {"enum": ["ollama", "openai_compat", "dryrun"]},
          "role": {"type": ["string", "null"]},
          "size_gb": {"type": ["number", "null"]},
          "vram_after_load_mb": {"type": ["number", "null"]},
          "gpu_share_pct": {"type": ["number", "null"]},
          "load_seconds": {"type": ["number", "null"]},
          "quant": {"type": ["string", "null"]}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "weight"],
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "kind": {"enum": ["auto", "rubric", "mixed"]},
          "weight": {"type": "number", "minimum": 0},
          "aggregate": {"enum": ["mean", "all"]}
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "task_id", "variant", "ttft_ms", "tokens_per_second", "prompt_tokens", "output_tokens", "total_seconds", "cost_usd", "score", "score_kind", "pass", "details", "output_file"],
        "properties": {
          "model": {"type": "string"},
          "task_id": {"type": "integer"},
          "variant": {"type": "string"},
          "ttft_ms": {"type": ["number", "null"]},
          "tokens_per_second": {"type": ["number", "null"]},
          "prompt_tokens": {"type": ["integer", "null"]},
          "output_tokens": {"type": ["integer", "null"]},
          "total_seconds": {"type": ["number", "null"]},
          "cost_usd": {"type": ["number", "null"]},
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "score_kind": {"enum": ["auto", "rubric", "mixed"]},
          "pass": {"type": ["boolean", "null"]},
          "error": {"type": ["string", "null"]},
          "details": {"type": "object"},
          "output_file": {"type": ["string", "null"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["score_total", "score_max", "passes", "avg_tps", "avg_ttft_ms", "cost_usd_total"],
        "properties": {
          "score_total": {"type": "number"},
          "score_max": {"type": "number"},
          "passes": {"type": "integer"},
          "avg_tps": {"type": ["number", "null"]},
          "avg_ttft_ms": {"type": ["number", "null"]},
          "cost_usd_total": {"type": ["number", "null"]},
          "unscored_task_ids": {"type": "array", "items": {"type": "integer"}}
        }
      }
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "latency_sensitive": {"type": ["string", "null"]},
          "quality_sensitive": {"type": ["string", "null"]},
          "vram_constrained": {"type": ["string", "null"]},
          "would_i_run_it": {"type": ["string", "null"]},
          "note": {"type": ["string", "null"]}
        }
      }
    }
  }
}
